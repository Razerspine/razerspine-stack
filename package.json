{
  "name": "webpack-starter-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for create-webpack-starter CLI and official Pug-based webpack starter templates.",
  "keywords": [
    "webpack",
    "starter",
    "pug",
    "scss",
    "less",
    "typescript",
    "javascript",
    "monorepo",
    "cli",
    "frontend"
  ],
  "author": "Razerspine",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Razerspine/webpack-starter-monorepo/issues"
  },
  "homepage": "https://github.com/Razerspine/webpack-starter-monorepo#readme",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build -ws",
    "dev:cli": "npm run dev -w @razerspine/create",
    "build:cli": "npm run build -w @razerspine/create",
    "test:cli": "npm run test -w @razerspine/create",
    "test:runtime": "npm run test -w @razerspine/runtime",
    "test:build": "npm run test:e2e:full -w @razerspine/build",
    "test:ui": "npm run test:full -w @razerspine/ui",
    "templates:install": "bash scripts/install-templates.sh",
    "templates:clean": "bash scripts/clean-templates.sh"
  }
}
