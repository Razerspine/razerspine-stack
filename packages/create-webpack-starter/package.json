{
  "name": "create-webpack-starter",
  "version": "0.2.6",
  "description": "Create a webpack starter with Pug, SCSS, TS and more",
  "bin": {
    "create-webpack-starter": "bin/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Razerspine/webpack-starter-monorepo.git",
    "directory": "packages/create-webpack-starter"
  },
  "homepage": "https://github.com/Razerspine/webpack-starter-monorepo/tree/main/packages/create-webpack-starter#readme",
  "bugs": {
    "url": "https://github.com/Razerspine/webpack-starter-monorepo/issues"
  },

  "files": [
    "bin",
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test:cleanup": "node e2e/helpers/cleanup.js",
    "test:e2e": "npm run build && npm run test:cleanup && (node e2e/basic.test.js && node e2e/template.test.js && node e2e/dry-run.test.js && node e2e/invalid-template.test.js); npm run test:cleanup",
    "dev": "ts-node src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "webpack",
    "starter",
    "cli",
    "pug",
    "scss",
    "less",
    "javascript",
    "typescript"
  ],
  "author": "Razerspine",
  "license": "ISC",
  "dependencies": {
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.3.0",
    "kleur": "^4.1.5",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
