{
  "name": "@razerspine/webpack-core",
  "version": "1.10.0",
  "description": "Core webpack config and loaders for starter templates",
  "keywords": [
    "webpack",
    "webpack-config",
    "pug",
    "pug-plugin"
  ],
  "license": "ISC",
  "author": "Razerspine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Razerspine/webpack-starter-monorepo.git",
    "directory": "packages/webpack-core"
  },
  "homepage": "https://github.com/Razerspine/webpack-starter-monorepo/blob/main/packages/webpack-core#readme",
  "bugs": {
    "url": "https://github.com/Razerspine/webpack-starter-monorepo/issues"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:snapshots": "vitest run tests/snapshots",
    "test:e2e:prepare": "npm install --prefix tests/fixtures/mpa && npm install --prefix tests/fixtures/spa",
    "test:e2e": "vitest run tests/e2e",
    "test:e2e:full": "npm run test:e2e:prepare && npm run test:e2e"
  },
  "peerDependencies": {
    "pug-plugin": "^5 || ^6",
    "webpack": "^5",
    "webpack-dev-server": "^5"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^29.0.0",
    "pug-plugin": "^6.1.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.0",
    "webpack": "^5.105.0",
    "webpack-dev-server": "^5.2.3",
    "webpack-merge": "^5.10.0"
  }
}
