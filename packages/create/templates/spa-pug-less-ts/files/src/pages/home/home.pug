include @shared/mixins/code.pug

block content
  section.section.m-b-4
    .container
      h1.title-h1.m-b-1.text-gradient-deep.text-center Razerspine Stack
      p.title-h5.slate-500.text-center Production-ready frontend application

  section.section.m-b-4
    .container
      .card.card--padding
        h3.title-h5.text-center.w-100 🟢 App is running successfully
        p.title-h5.slate-500.text-center.w-100 Webpack development server is active and ready.

  section.section.m-b-4
    .container
      .card.card--padding
        ul.template-meta
          li.template-meta__row
            span.title-h5.text-gradient-soft App Type:
            span.title-h5(data-bind='appType')
          li.template-meta__row
            span.title-h5.text-gradient-soft Script:
            span.title-h5(data-bind='script')
          li.template-meta__row
            span.title-h5.text-gradient-soft Style:
            span.title-h5(data-bind='style')
          li.template-meta__row
            span.title-h5.text-gradient-soft Version:
            span.title-h5(data-bind='version')


  section.section.m-b-4
    .container
      h2.title-h2.m-b-4 What’s Included
      .row.row--gap-25
        .col-12.col-md-6.col-lg-3
          .card
            h3.title-h4.m-b-2.text-gradient-soft Webpack Core
            p
              | Stable, minimal webpack configuration with alias support,
              | environment separation and production-ready setup.

        .col-12.col-md-6.col-lg-3
          .card
            h3.title-h4.m-b-2.text-gradient-soft Single Page App
            p
              | One entry point (app.pug) serving as the shell.
              | Ready for your custom TypeScript router or framework.

        .col-12.col-md-6.col-lg-3
          .card
            h3.title-h4.m-b-2.text-gradient-soft Runtime Services
            p
              | ThemeService, TranslationService and ApiService
              | included via shared npm packages.

        .col-12.col-md-6.col-lg-3
          .card
            h3.title-h4.m-b-2.text-gradient-soft Clean Architecture
            p
              | CLI is only a generator. Generated project
              | has no runtime dependency on the CLI.

  section.section
    .container
      h1.title-h2.m-b-4 What next
      .content
        .d-flex.flex-row
          p.title-h6.m-r-1 Initialize your Router in:
          +code('text-inline') src/app/app.ts
        .d-flex.flex-row
          p.title-h6.m-r-1 Add translations in:
          +code('text-inline') assets/i18n
        .d-flex.flex-row
          p.title-h6.m-r-1 Use aliases like:
          +code('text-inline') @app
          +code('text-inline') @pages
          +code('text-inline') @shared
          +code('text-inline') @styles
          +code('text-inline') @images
          +code('text-inline') @icons
