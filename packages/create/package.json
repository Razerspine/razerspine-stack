{
  "name": "@razerspine/create",
  "version": "1.0.0",
  "description": "Create a webpack starter with Pug, SCSS, TS and more",
  "author": "Razerspine",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Razerspine/razerspine-stack.git",
    "directory": "packages/create"
  },
  "homepage": "https://github.com/Razerspine/razerspine-stack/tree/main/packages/create#readme",
  "bugs": {
    "url": "https://github.com/Razerspine/razerspine-stack/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "templates",
    "!templates/**/node_modules",
    "!templates/**/dist",
    "!templates/**/package-lock.json",
    "!templates/**/.cache",
    "!templates/**/coverage",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "create": "./dist/index.js"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsup",
    "create": "tsx src/index.ts",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "webpack",
    "cli",
    "pug",
    "scss",
    "less",
    "javascript",
    "typescript"
  ],
  "dependencies": {
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^8.2.6",
    "kleur": "^4.1.5",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@vitest/coverage-v8": "^4.1.0",
    "@types/inquirer": "^9.0.9",
    "jsdom": "^29.0.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
