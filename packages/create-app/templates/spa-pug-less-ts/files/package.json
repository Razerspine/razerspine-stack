{
  "name": "webpack-template-spa-pug-less-ts",
  "private": true,
  "version": "0.0.5",
  "description": "Create App Template SPA: Pug + Less + TypeScript",
  "templateMeta": "spa-pug-less-ts",
  "scripts": {
    "dev": "webpack serve --mode=development",
    "build": "webpack --mode=production",
    "preview": "npm run build && http-server dist --port 4323 -o -P http://localhost:4323/index.html?",
    "test:build:netlify": "NETLIFY=true npm run build",
    "test:build:vercel": "VERCEL=true npm run build",
    "test:build:github": "GITHUB_ACTIONS=true npm run build",
    "test:build:cloudflare": "CF_PAGES=true npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "autoprefixer": "^10.4.23",
    "css-loader": "^6.10.0",
    "dotenv": "^16.4.5",
    "http-server": "^14.1.1",
    "parse5": "^7.1.2",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "prettier": "^3.2.5",
    "pug-plugin": "^6.1.0",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.3",
    "webpack-merge": "^5.10.0",
    "@razerspine/build": "^1.0.0",
    "less": "^4.5.1",
    "less-loader": "^12.3.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@razerspine/ui": "^1.0.0",
    "@razerspine/runtime": "^1.0.1"
  }
}
