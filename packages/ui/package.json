{
  "name": "@razerspine/ui",
  "version": "1.0.2",
  "description": "UI kit with SCSS/LESS sources, compiled CSS, and Pug components for modern frontend projects",
  "license": "ISC",
  "author": "Razerspine",
  "repository": {
    "type": "git",
    "url": "https://github.com/Razerspine/razerspine-stack",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/Razerspine/razerspine-stack/tree/main/packages/ui",
  "bugs": {
    "url": "https://github.com/Razerspine/razerspine-stack/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ui",
    "ui-kit",
    "design-system",
    "pug",
    "pug-mixins",
    "scss",
    "less",
    "css",
    "frontend",
    "webpack"
  ],
  "files": [
    "dist",
    "fonts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/css/ui.min.css",
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.less"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./scss": "./dist/scss/ui.scss",
    "./scss/*": "./dist/scss/*",
    "./less": "./dist/less/ui.less",
    "./less/*": "./dist/less/*",
    "./mixins/*": "./dist/pug/mixins/*",
    "./fonts/*": "./fonts/*",
    "./css/*": "./dist/css/*"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:css": "tsx scripts/index.ts",
    "build:copy": "tsx scripts/copy.ts",
    "build:ts": "tsc",
    "build": "npm run clean && npm run build:css && npm run build:copy && npm run build:ts",
    "check:less": "tsx scripts/check-less.ts",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:snapshots": "vitest run tests/snapshots",
    "test:full": "npm run build && npm run setup:fixtures && npm run test",
    "setup:fixtures": "npm --prefix tests/fixtures/with-runtime install && npm --prefix tests/fixtures/without-runtime install",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.19",
    "cssnano": "^6.1.2",
    "jsdom": "^28.1.0",
    "less": "^4.6.4",
    "postcss": "^8.4.38",
    "postcss-cli": "^11.0.0",
    "rimraf": "^6.1.3",
    "sass": "^1.77.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
