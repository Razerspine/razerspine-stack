  "_single-select.less": "@import '_form-control'; .single-select { .form-control(); appearance: none; -webkit-appearance: none; -moz-appearance: none; background-image: var(--select-arrow); background-repeat: no-repeat; background-position: right .5rem center; background-size: 1rem; cursor: pointer; padding: .5rem 1.5rem .5rem .75rem; &:invalid { color: var(--text-secondary); } option { color: var(--text-primary); background-color: var(--bg-subtle); padding: 0.5rem; &:disabled { color: var(--text-primary); opacity: .6; } } }",
  "_table.less": "@import '../settings/_index'; .table-wrapper { display: block; width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; } .table { width: 100%; border-collapse: collapse; font-family: @font-family; font-size: .95rem; color: var(--text-primary); background: var(--bg-surface); th, td { padding: .75rem; border-bottom: 1px solid var(--border-subtle); vertical-align: middle; text-align: left; white-space: nowrap; } thead { background: var(--bg-subtle); th { font-weight: 700; } } tbody tr:hover { background: var(--bg-subtle); } .table-sm th, .table-sm td { padding: .4rem .6rem; } .table-striped tbody tr:nth-child(odd) { background: rgba(0, 0, 0, .02); } }",
