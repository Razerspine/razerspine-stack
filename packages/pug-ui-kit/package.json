{
  "name": "@razerspine/pug-ui-kit",
  "version": "1.5.1",
  "description": "Shared Pug mixins for Webpack Starter templates",
  "keywords": [
    "pug",
    "components",
    "mixins"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/css/ui.min.css",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./scss/*": "./src/styles/scss/*",
    "./less/*": "./src/styles/less/*",
    "./pug/*": "./src/pug/*",
    "./fonts/*": "./fonts/*",
    "./css/*": "./dist/css/*"
  },
  "files": [
    "dist",
    "fonts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build:css": "ts-node builder/index.ts",
    "build:ts": "tsc",
    "build": "npm run clean && npm run build:css && npm run build:ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "autoprefixer": "^10.4.19",
    "cssnano": "^6.1.2",
    "postcss": "^8.4.38",
    "postcss-cli": "^11.0.0",
    "sass": "^1.77.0",
    "typescript": "^5.9.3"
  }
}
