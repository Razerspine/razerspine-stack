{
  "name": "@razerspine/pug-ui-kit",
  "version": "1.5.1",
  "description": "Shared Pug mixins for Webpack Starter templates",
  "keywords": [
    "pug",
    "components",
    "mixins"
  ],
  "files": [
    "dist",
    "fonts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/css/ui.min.css",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./scss": "./dist/scss/ui.scss",
    "./scss/*": "./dist/scss/*",
    "./less": "./dist/less/ui.less",
    "./less/*": "./dist/less/*",
    "./mixins/*": "./dist/pug/mixins/*",
    "./fonts/*": "./fonts/*",
    "./css/*": "./dist/css/*"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:css": "ts-node builder/index.ts",
    "build:ts": "tsc",
    "copy": "ts-node builder/copy.ts",
    "build": "npm run clean && npm run build:css && npm run build:ts && npm run copy",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^28.1.0",
    "autoprefixer": "^10.4.19",
    "cssnano": "^6.1.2",
    "postcss": "^8.4.38",
    "postcss-cli": "^11.0.0",
    "rimraf": "^6.1.3",
    "sass": "^1.77.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
