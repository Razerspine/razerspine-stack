{
  "name": "@razerspine/starter-core-scripts",
  "version": "0.5.1",
  "description": "Core script services for webpack starter templates",
  "license": "ISC",
  "author": "Razerspine",
  "repository": {
    "type": "git",
    "url": "https://github.com/Razerspine/webpack-starter-monorepo",
    "directory": "packages/starter-core-scripts"
  },
  "homepage": "https://github.com/Razerspine/webpack-starter-monorepo/blob/main/packages/starter-core-scripts#readme",
  "bugs": {
    "url": "https://github.com/Razerspine/webpack-starter-monorepo/issues"
  },
  "keywords": [
    "spa",
    "typescript",
    "dependency-injection",
    "router",
    "di-container",
    "frontend-core",
    "starter-kit",
    "web-services",
    "theme-manager",
    "i18n-service",
    "api-client",
    "webpack-template",
    "zero-config",
    "vanilla-js"
  ],
  "type": "module",
  "private": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js",
      "require": "./dist/http/index.cjs"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform/index.js",
      "require": "./dist/platform/index.cjs"
    },
    "./reactivity": {
      "types": "./dist/reactivity/index.d.ts",
      "import": "./dist/reactivity/index.js",
      "require": "./dist/reactivity/index.cjs"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.js",
      "require": "./dist/router/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    },
    "./view": {
      "types": "./dist/view/index.d.ts",
      "import": "./dist/view/index.js",
      "require": "./dist/view/index.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
