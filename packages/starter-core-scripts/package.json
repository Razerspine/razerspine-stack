{
  "name": "@razerspine/starter-core-scripts",
  "version": "0.2.0",
  "description": "Core script services for webpack starter templates",
  "license": "ISC",
  "author": "Razerspine",
  "type": "module",
  "private": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
